# ==========================================
# BestResponse / Multi-LLM Arena .gitignore
# ==========================================

# --- CRITICAL SECURITY: Browser Profiles & Credentials ---
# Contains active session cookies, auth tokens, and browsing data
browser_profile/
*.session
*.cookies
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt

# --- Environments & Dependencies ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
build/
dist/
*.egg-info/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# --- Databases & Runtime Data ---
data/
*.db
*.sqlite
*.sqlite3

# --- Logs & Debugging ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS & System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Playwright & Test Artifacts ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
